# PowerShell 7.5.3 on Ubuntu 24.04; mcr.microsoft.com/powershell pulls a 32-bit arm image on this host, so the tarball is used instead.
FROM ubuntu:24.04
ARG TARGETARCH
RUN apt-get update -qq \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends git ca-certificates curl libicu74 bsdutils >/dev/null \
	&& rm -rf /var/lib/apt/lists/*
COPY fzf.sha256 pwsh.sha256 /tmp/
RUN set -e; case "$TARGETARCH" in arm64) p=arm64 ;; amd64) p=x64 ;; esac \
	&& cd /tmp \
	&& curl -fsSL -o powershell-7.5.3-linux-$p.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v7.5.3/powershell-7.5.3-linux-$p.tar.gz \
	&& grep "linux-$p.tar.gz" pwsh.sha256 | sed 's/ \*/  /' | sha256sum -c - \
	&& mkdir -p /opt/pwsh && tar -xzf powershell-7.5.3-linux-$p.tar.gz -C /opt/pwsh && chmod +x /opt/pwsh/pwsh \
	&& ln -s /opt/pwsh/pwsh /usr/local/bin/pwsh && rm powershell-*.tar.gz
RUN curl -fsSL -o /tmp/fzf-0.73.1-linux_${TARGETARCH}.tar.gz https://github.com/junegunn/fzf/releases/download/v0.73.1/fzf-0.73.1-linux_${TARGETARCH}.tar.gz \
	&& cd /tmp && grep "linux_${TARGETARCH}.tar.gz" fzf.sha256 | sha256sum -c - \
	&& tar -xzf fzf-0.73.1-linux_${TARGETARCH}.tar.gz -C /usr/local/bin fzf && rm /tmp/fzf-* \
	&& git config --system safe.directory '*'
