== NORMAL start
"--ansi"
"--delimiter=\t"
"--with-nth=1,4"
"--exact"
"-i"
"--nth=.."
"--no-tac"
"--scheme=default"
"--tiebreak=begin,chunk"
"--with-shell='/opt/hop dir/bin/hop' __sh"
"--accept-nth=2,3,4"
"--no-multi"
"--layout=reverse"
"--info=inline"
"--border=rounded"
"--border-label= repo  12 targets  tg,mod "
"--header-first"
"--header-border=bottom"
"--pointer=▸"
"--expect=ctrl-o,ctrl-t,ctrl-y,alt-o,alt-y,ctrl-h"
"--preview=hop __preview {2} {3}"
"--preview-window=right,55%,border-left,wrap,<120(down,50%,border-top,wrap)"
"--bind=ctrl-/:toggle-preview"
"--bind=alt-p:toggle-preview"
"--bind=ctrl-r:refresh-preview"
"--bind=ctrl-g:ignore"
"--bind=alt-B:print(ctrl-g)+accept"
"--bind=alt-enter:transform:hop __key alt-enter"
"--height=80%"
"--min-height=18"
"--freeze-left=1"
"--bind=alt-a:reload(hop __rows tg mod helm dir file)"
"--select-1"
"--bind=a:ignore"
