"--disabled"
"--prompt=> "
"--header=NORMAL  j/k move  g/G top/bot  / search  ? help  enter cd  q quit"
== repo level HOP_VIM=0
"--ansi"
"--delimiter=\t"
"--with-nth=1,4"
"--exact"
